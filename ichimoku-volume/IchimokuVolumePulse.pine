// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © JARVIS OS — Ichimoku Volume Pulse
//
// Compagnon d'Ichimoku : lit le volume automatiquement, le colore selon le biais
// du nuage, et confirme les croisements TK / sorties de cloud avec le volume relatif.

//@version=5
indicator("Ichimoku Volume Pulse", shorttitle="IchiVol", overlay=false, timeframe="", timeframe_gaps=true)

// ─── Inputs ─────────────────────────────────────────────────────────────────
grpIchi = "Ichimoku (paramètres standards)"
tenkanLen  = input.int(9,  "Tenkan-sen",   minval=1, group=grpIchi)
kijunLen   = input.int(26, "Kijun-sen",    minval=1, group=grpIchi)
senkouBLen = input.int(52, "Senkou Span B", minval=1, group=grpIchi)
displacement = input.int(26, "Displacement", minval=1, group=grpIchi)

grpVol = "Volume"
rvolLen     = input.int(20, "Période volume moyen (RVOL)", minval=2, group=grpVol)
rvolConfirm = input.float(1.5, "Seuil confirmation RVOL", minval=0.5, step=0.1, group=grpVol,
     tooltip="Volume courant / SMA(volume). ≥ seuil = confirmation.")
spikeMult   = input.float(2.0, "Seuil spike volume", minval=1.0, step=0.1, group=grpVol)
smoothVol   = input.int(3, "Lissage volume (SMA)", minval=1, group=grpVol)

grpVis = "Affichage"
showHist    = input.bool(true,  "Histogramme volume", group=grpVis)
showAvg     = input.bool(true,  "Ligne volume moyen", group=grpVis)
showBgRvol  = input.bool(true,  "Fond quand RVOL confirme", group=grpVis)
showMarkers = input.bool(true,  "Marqueurs signaux confirmés", group=grpVis)
showTable   = input.bool(true,  "Tableau de lecture", group=grpVis)
paintBars   = input.bool(false, "Colorer les bougies du prix", group=grpVis,
     tooltip="barcolor() colore le graphique principal même depuis un indicateur pane.")

grpCol = "Couleurs"
colBullCloud = input.color(color.new(#26A69A, 0), "Au-dessus du cloud (haussier)", group=grpCol)
colBearCloud = input.color(color.new(#EF5350, 0), "Sous le cloud (baissier)", group=grpCol)
colInCloud   = input.color(color.new(#FFB74D, 0), "Dans le cloud (neutre)", group=grpCol)
colWeak      = input.color(color.new(#78909C, 55), "Volume faible (sous moyenne)", group=grpCol)
colAvg       = input.color(color.new(#90A4AE, 0), "Volume moyen", group=grpCol)
colSignalUp  = input.color(color.new(#00E676, 0), "Signal long confirmé", group=grpCol)
colSignalDn  = input.color(color.new(#FF1744, 0), "Signal short confirmé", group=grpCol)

// ─── Volume auto ────────────────────────────────────────────────────────────
// Sur indices / synthétiques sans volume, TradingView fournit souvent na.
volRaw = volume
hasVolume = not na(volRaw) and volRaw > 0
vol = hasVolume ? volRaw : 0.0
volSmooth = ta.sma(vol, smoothVol)
volAvg = ta.sma(vol, rvolLen)
rvol = volAvg > 0 ? vol / volAvg : 0.0
isConfirmed = rvol >= rvolConfirm
isSpike = rvol >= spikeMult

// ─── Ichimoku (recalcul local pour jumelage fiable) ─────────────────────────
// Formule classique : (plus haut + plus bas) / 2 sur la fenêtre — pas hl2.
donchianMid(len) =>
    (ta.highest(high, len) + ta.lowest(low, len)) / 2.0

tenkan = donchianMid(tenkanLen)
kijun  = donchianMid(kijunLen)
senkouA = (tenkan + kijun) / 2.0
senkouB = donchianMid(senkouBLen)

// Nuage « actuel » = spans décalés en avant, donc on lit la valeur publiée
// displacement barres en arrière (valeur du cloud sous le prix courant).
cloudTop = math.max(senkouA[displacement], senkouB[displacement])
cloudBot = math.min(senkouA[displacement], senkouB[displacement])

aboveCloud = close > cloudTop
belowCloud = close < cloudBot

cloudBullish = senkouA[displacement] >= senkouB[displacement]  // twist haussier

// ─── Croisements TK & sorties de cloud ──────────────────────────────────────
tkCrossUp = ta.crossover(tenkan, kijun)
tkCrossDn = ta.crossunder(tenkan, kijun)

breakCloudUp = ta.crossover(close, cloudTop)
breakCloudDn = ta.crossunder(close, cloudBot)

// Signaux confirmés par le volume
longTk   = tkCrossUp and aboveCloud and isConfirmed and hasVolume
shortTk  = tkCrossDn and belowCloud and isConfirmed and hasVolume
longBrk  = breakCloudUp and isConfirmed and hasVolume
shortBrk = breakCloudDn and isConfirmed and hasVolume

longSignal  = longTk or longBrk
shortSignal = shortTk or shortBrk

// ─── Couleur histogramme (biais Ichimoku × force volume) ────────────────────
volColor() =>
    if not hasVolume
        color.new(color.gray, 70)
    else if vol < volAvg
        colWeak
    else if aboveCloud
        color.new(colBullCloud, isSpike ? 0 : 35)
    else if belowCloud
        color.new(colBearCloud, isSpike ? 0 : 35)
    else
        color.new(colInCloud, isSpike ? 0 : 40)

// ─── Plots (échelle volume uniquement — RVOL reste dans le tableau) ─────────
plot(showHist ? volSmooth : na, title="Volume", style=plot.style_columns, color=volColor(), histbase=0)
plot(showAvg ? volAvg : na, title="Volume moyen", color=colAvg, linewidth=2)

bgcolor(showBgRvol and hasVolume and isConfirmed ? (aboveCloud ? color.new(colBullCloud, 92) : belowCloud ? color.new(colBearCloud, 92) : color.new(colInCloud, 92)) : na,
     title="Fond confirmation RVOL")

plotshape(showMarkers and longSignal,  title="Long confirmé",  style=shape.triangleup,
     location=location.bottom, color=colSignalUp, size=size.small, text="VOL↑")
plotshape(showMarkers and shortSignal, title="Short confirmé", style=shape.triangledown,
     location=location.top, color=colSignalDn, size=size.small, text="VOL↓")

// Colorer les bougies du graphique principal (optionnel)
barcolor(paintBars ? (longSignal ? colSignalUp : shortSignal ? colSignalDn : aboveCloud ? color.new(colBullCloud, 70) : belowCloud ? color.new(colBearCloud, 70) : na) : na)

// ─── Tableau de lecture automatique ─────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 6, bgcolor=color.new(#0D1117, 15),
     border_color=color.new(#30363D, 0), border_width=1)

if showTable and barstate.islast
    biasTxt = not hasVolume ? "⚠️ Pas de volume" : aboveCloud ? "HAUSSIER (au-dessus)" : belowCloud ? "BAISSIER (en-dessous)" : "NEUTRE (dans le cloud)"
    biasCol = not hasVolume ? color.gray : aboveCloud ? colBullCloud : belowCloud ? colBearCloud : colInCloud
    twistTxt = cloudBullish ? "Twist ▲" : "Twist ▼"
    rvolTxt = hasVolume ? str.tostring(rvol, "#.##") + "×" : "—"
    confTxt = not hasVolume ? "N/A" : isSpike ? "SPIKE" : isConfirmed ? "Confirmé" : "Faible"

    table.cell(dash, 0, 0, "IchiVol", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, twistTxt, text_color=cloudBullish ? colBullCloud : colBearCloud, text_size=size.small)
    table.cell(dash, 0, 1, "Biais cloud", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 1, biasTxt, text_color=biasCol, text_size=size.tiny)
    table.cell(dash, 0, 2, "RVOL", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 2, rvolTxt, text_color=isConfirmed ? colBullCloud : color.white, text_size=size.tiny)
    table.cell(dash, 0, 3, "Volume", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 3, confTxt, text_color=isSpike ? colSignalUp : isConfirmed ? colBullCloud : colWeak, text_size=size.tiny)
    table.cell(dash, 0, 4, "Tenkan", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 4, str.tostring(tenkan, format.mintick), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 5, "Kijun", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 5, str.tostring(kijun, format.mintick), text_color=color.white, text_size=size.tiny)

// ─── Alertes ────────────────────────────────────────────────────────────────
alertcondition(longTk,   title="TK Cross haussier + volume",
     message="IchiVol: croisement Tenkan/Kijun haussier confirmé par le volume")
alertcondition(shortTk,  title="TK Cross baissier + volume",
     message="IchiVol: croisement Tenkan/Kijun baissier confirmé par le volume")
alertcondition(longBrk,  title="Breakout cloud + volume",
     message="IchiVol: sortie haussière du cloud confirmée par le volume")
alertcondition(shortBrk, title="Breakdown cloud + volume",
     message="IchiVol: sortie baissière du cloud confirmée par le volume")
alertcondition(isSpike and hasVolume, title="Spike volume",
     message="IchiVol: spike de volume détecté")
