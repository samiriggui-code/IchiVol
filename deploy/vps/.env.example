# Copy to .env on the VPS (never commit real values)
POSTGRES_USER=ichivol
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=ichivol

JWT_SECRET=change-me-64-hex
# SETTINGS_SECRET=

LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TWELVE_DATA_API_KEY=

# Optional: seed admin on first boot (server entrypoint)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

LOG_LEVEL=info

# --- JEV / System One (Ève) — not OpenRouter chat ---
# Primary = JEV API (typesafe). jevos = fallback when API credits/quota are gone.
JEV_PROVIDER=typesafe
JEV_FALLBACK=jevos
JEV_URL=http://jevos-v4:8017
JEV_MODEL=jev-latest
JEV_API_KEY=
JEV_SHADOW_ENABLED=false
# Hosted TypeSafe Jev — official key from console.typesafe.ai
TYPESAFE_API_URL=https://api.typesafe.ai
TYPESAFE_API_KEY=

# Ève décide seule (paper) : à true, chaque portefeuille du moteur propose ses trades et Ève + JEV
# les acceptent ou les refusent à chaque nouvelle bougie ; le moteur n'ouvre/ferme plus rien lui-même
# (stops et objectifs restent actifs). Le Risk Kernel garde le dernier mot. Jamais de broker réel.
EVE_PAPER_AUTONOMY=false

# Event Radar (context enrichment for all Eve modes)
EVENT_RADAR_ENABLED=true
EVENT_RADAR_CRYPTO_RSS_ENABLED=true
EVENT_RADAR_YAHOO_FINANCE_RSS_ENABLED=true
EVENT_RADAR_SEC_EDGAR_ENABLED=true

# Collecte auto de preuve backtest (condition 1 gate broker live) -- tourne
# dans le process engine, pas de service séparé. true par défaut sur le VPS.
ENABLE_BACKTEST_EVIDENCE=true
BACKTEST_EVIDENCE_INTERVAL_S=86400

# Flux direct Binance (WebSocket public, aucune clé) : stops / objectifs temps réel des lots crypto du compte
# unique. Flux muet depuis LIVE_FEED_STALE_S s -> « dégradé » : reconnexion + relevés REST toutes les
# LIVE_FEED_REST_POLL_S s. false = retour au scan 5 min + moniteur 1m seuls.
ENABLE_LIVE_FEED=true
LIVE_FEED_STALE_S=10
LIVE_FEED_REST_POLL_S=5

# Notifications système (watchdog santé + digest quotidien, 2026-09-17).
# Non configuré = emails désactivés silencieusement, notifications in-app OK quand même.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="IchiVol <no-reply@example.com>"
SMTP_SECURE=false
ALERT_EMAIL_TO=
