# Copy to .env on the VPS (never commit real values)
POSTGRES_USER=ichivol
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=ichivol

JWT_SECRET=change-me-64-hex
# SETTINGS_SECRET=

LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TWELVE_DATA_API_KEY=

# Optional: seed admin on first boot (server entrypoint)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

LOG_LEVEL=info

# Collecte auto de preuve backtest (condition 1 gate broker live) -- tourne
# dans le process engine, pas de service séparé. true par défaut sur le VPS.
ENABLE_BACKTEST_EVIDENCE=true
BACKTEST_EVIDENCE_INTERVAL_S=86400

# Notifications système (watchdog santé + digest quotidien, 2026-09-17).
# Non configuré = emails désactivés silencieusement, notifications in-app OK quand même.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="IchiVol <no-reply@example.com>"
SMTP_SECURE=false
ALERT_EMAIL_TO=

# Phase 2 MT5 (READ ONLY) — voir ichivol-app/mt5-bridge/README.md.
# MT5_ENABLED reste false tant que le bridge n'est pas vérifié en live
# (docker compose --profile mt5 up -d mt5-bridge). Ne JAMAIS committer
# de vrais identifiants MT5_LOGIN/MT5_PASSWORD.
MT5_ENABLED=false
MT5_MODE=READ_ONLY
MT5_BRIDGE_URL=http://mt5-bridge:8000
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
