# Copy to .env on the VPS (never commit real values)
POSTGRES_USER=ichivol
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=ichivol

JWT_SECRET=change-me-64-hex
# SETTINGS_SECRET=

LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TWELVE_DATA_API_KEY=

# Optional: seed admin on first boot (server entrypoint)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

LOG_LEVEL=info

# Collecte auto de preuve backtest (condition 1 gate broker live) -- tourne
# dans le process engine, pas de service séparé. true par défaut sur le VPS.
ENABLE_BACKTEST_EVIDENCE=true
BACKTEST_EVIDENCE_INTERVAL_S=86400

# Notifications système (watchdog santé + digest quotidien, 2026-09-17).
# Non configuré = emails désactivés silencieusement, notifications in-app OK quand même.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="IchiVol <no-reply@example.com>"
SMTP_SECURE=false
ALERT_EMAIL_TO=

# Ève Intelligence V1 -- JEV (TypeSafe). Clé dans JEV_API_KEY (jamais commitée). Sans clé, ou quand TypeSafe
# refuse un appel (plus de crédit, panne), Ève passe sur jevos-v4 local (service docker jevos-v4).
JEV_API_KEY=
JEV_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
# Plafond d'appels JEV hébergé par jour (protège le crédit). jevos-v4 n'est pas plafonné.
JEV_DAILY_MAX_CALLS=1000
# false = Ève n'appelle plus JEV et ses portefeuilles ne bougent plus (stop / objectif restent actifs).
EVE_ENABLED=true
# false = V1 : Dossiers seulement, les portefeuilles Ève n'exécutent pas ses décisions.
EVE_EXECUTION=true
