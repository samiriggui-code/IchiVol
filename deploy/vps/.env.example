# Copy to .env on the VPS (never commit real values)
POSTGRES_USER=ichivol
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=ichivol

JWT_SECRET=change-me-64-hex
# SETTINGS_SECRET=

LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TWELVE_DATA_API_KEY=

# Optional: seed admin on first boot (server entrypoint)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

LOG_LEVEL=info

# --- JEV / jevos System One (Ève Shadow) — not OpenRouter chat ---
# JEV_PROVIDER=jevos|typesafe  (default jevos = local jevos-v4 already on VPS)
JEV_PROVIDER=jevos
JEV_URL=http://jevos-v4:8017
JEV_MODEL=jev-latest
JEV_API_KEY=
JEV_SHADOW_ENABLED=false
# Hosted TypeSafe Jev (config C) — official key from console.typesafe.ai
TYPESAFE_API_URL=https://api.typesafe.ai
TYPESAFE_API_KEY=

# Eve paper test: when true, Risk Kernel may open/close on existing paper books.
# Never live broker. Keep false unless actively testing decision→trade.
EVE_PAPER_AUTONOMY=false

# Collecte auto de preuve backtest (condition 1 gate broker live) -- tourne
# dans le process engine, pas de service séparé. true par défaut sur le VPS.
ENABLE_BACKTEST_EVIDENCE=true
BACKTEST_EVIDENCE_INTERVAL_S=86400

# Notifications système (watchdog santé + digest quotidien, 2026-09-17).
# Non configuré = emails désactivés silencieusement, notifications in-app OK quand même.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="IchiVol <no-reply@example.com>"
SMTP_SECURE=false
ALERT_EMAIL_TO=
