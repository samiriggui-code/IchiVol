{
  "name": "ichivol-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run dev --prefix server",
    "dev:engine": "cd engine && .venv/Scripts/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
    "dev:stack": "npx --yes concurrently -k -n web,api,engine -c cyan,magenta,green \"npm run dev\" \"npm run dev:api\" \"npm run dev:engine\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "puppeteer-core": "^23.11.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
