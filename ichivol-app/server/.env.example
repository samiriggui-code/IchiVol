PORT=8787
NODE_ENV=development

# DB dédiée IchiVol — zéro partage avec GSMS/CRM
DATABASE_URL="postgresql://postgres:root@127.0.0.1:5432/ichivol_dev?schema=public"

# secret JWT session — générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# optionnel : chiffrement clés LLM en DB (sinon dérivé de JWT_SECRET)
# SETTINGS_SECRET=

# Fallback LLM si l'admin n'a pas encore saisi de clé dans /app/settings
# anthropic | openai | openrouter
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Moteur Python (ichivol-app/engine) — proxy sous /api/engine/*
# ENGINE_URL=http://127.0.0.1:8000

# Notifications système (watchdog santé + digest quotidien, 2026-09-17).
# Non configuré = emails désactivés silencieusement (log une seule fois),
# les notifications in-app continuent de fonctionner dans tous les cas.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="IchiVol <no-reply@example.com>"
SMTP_SECURE=false
ALERT_EMAIL_TO=
# WATCHDOG_INTERVAL_MS=300000
# DIGEST_INTERVAL_MS=86400000
