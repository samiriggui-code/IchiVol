generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  setting       Setting?
  decisions     Decision[]
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  agentThreads  AgentThread[]
  agentActions  AgentAction[]
  auditLogs     AuditLog[]
  watchlist     WatchlistItem[]

  @@map("users")
}

model Setting {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeSources   Json     @default("[\"binance\"]")
  ichimokuParams  Json     @default("{\"tenkan\":9,\"kijun\":26,\"senkouB\":52,\"displacement\":26}")
  volumeParams    Json     @default("{\"rvolLen\":20,\"rvolConfirm\":1.5,\"spikeMult\":2}")
  theme           String   @default("dark")
  llmProvider     String   @default("openrouter")
  llmModel        String   @default("openai/gpt-4o-mini")
  llmApiKeyEnc    String?
  /// Clés LLM chiffrées, une par fournisseur : { anthropic: enc, openrouter: enc, ... }
  llmKeysEnc      Json?
  twelveDataApiKeyEnc String?
  /// T0-NOTIF — prefs alertes push (JSON) ; jamais d'ordre auto
  pushAlertPrefs  Json?
  updatedAt       DateTime @updatedAt

  @@map("settings")
}

model Decision {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol         String
  interval       String
  /// Direction agent (LONG|SHORT|NEUTRAL)
  bias           String
  rvol           Float
  /// Combiner legacy (STRONG_BUY|BUY|…)
  signalKind     String?
  /// Verdict portes (BUY|SELL|WATCH|NO_TRADE) si pipeline natif
  gateDecision   String?
  confidence     Float?
  note           String?
  /// confirmed | dismissed | archived
  status         String   @default("confirmed")
  /// Empreinte pipeline pour le watch (gate + stages) — null = pas encore pollé
  watchFingerprint String?
  /// Dernier passage du watch job (rotation fair)
  watchCheckedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, symbol])
  @@index([userId, createdAt])
  @@index([userId, status])
  @@map("decisions")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// journal_confirm | pipeline_change | system_alert | system_digest
  /// | position_target_near | position_stop_near | position_accel | position_direction_flip
  kind      String
  title     String
  body      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/// T0-NOTIF — Web Push subscriptions (VAPID). One row per (user, endpoint).
model PushSubscription {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String
  p256dh     String
  auth       String
  userAgent  String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}

/// Conversation Copilot persistée (E4 / audit P3).
model AgentThread {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String?
  /// Slots fpa-like
  assumedSymbol    String?
  assumedTimeframe String?
  pendingIntent    String?
  lastMode         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  messages         AgentMessage[]

  @@index([userId, updatedAt])
  @@map("agent_threads")
}

model AgentMessage {
  id        String   @id @default(uuid())
  threadId  String
  thread    AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// user | assistant
  role      String
  content   String
  mode      String?
  intent    String?
  citations Json?
  /// AG0: tool calls, model, promptVersion, usage — rebuild a conversation from DB.
  meta      Json?
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  @@map("agent_messages")
}

/// Action orchestrée allowlist (E5 / audit P5).
model AgentAction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// save_decision | pin_symbol
  kind      String
  /// proposed | confirmed | rejected | failed
  status    String   @default("proposed")
  symbol    String?
  timeframe String?
  threadId  String?
  payload   Json?
  result    Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, status])
  @@map("agent_actions")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// agent.action.confirm | agent.action.reject | …
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Watchlist user (pin_symbol).
model WatchlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, symbol])
  @@index([userId, updatedAt])
  @@map("watchlist_items")
}

/// Chantier 2 E0 — durable agent task queue (Comp AI pattern, Prisma server).
/// Claim via FOR UPDATE SKIP LOCKED. LLM wake / evaluate_watch = E1/E2.
model AgentTask {
  id             String    @id @default(uuid())
  /// Lane / agent id (mono-agent: "eve" | "copilot" until multi-agent proven).
  agentId        String
  /// recheck | mission | digest | …
  kind           String
  symbol         String?
  payload        Json?
  /// Watch condition DSL — opaque in E0; evaluated by engine in E2.
  condition      Json?
  dueAt          DateTime
  /// pending | leased | completed | failed | retired
  status         String    @default("pending")
  leaseUntil     DateTime?
  attempts       Int       @default(0)
  /// Unique per logical attempt — retries must reuse, never mint a new key.
  idempotencyKey String    @unique
  result         Json?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  logs AgentLog[]

  @@index([status, dueAt])
  @@index([leaseUntil])
  @@index([agentId, kind, symbol])
  @@map("agent_tasks")
}

/// Chantier 2 E0 — agent runtime audit trail (PASSE / PRUDENCE / REFUSÉ).
model AgentLog {
  id         String   @id @default(uuid())
  agentId    String
  /// PASSE | PRUDENCE | REFUSÉ
  level      String
  source     String
  message    String
  /// Optional refs — decision is Prisma; position lives in engine DB (string id only).
  decisionId String?
  positionId String?
  taskId     String?
  task       AgentTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([taskId, createdAt])
  @@index([level, createdAt])
  @@map("agent_logs")
}
