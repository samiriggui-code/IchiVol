DATABASE_URL=postgresql+psycopg://postgres:root@127.0.0.1:5432/ichivol_engine_dev
ENGINE_API_PREFIX=/api/engine
LOG_LEVEL=info
# Phase 1b — multi-actifs (ne pas committer la vraie clé ; mettre dans .env)
TWELVE_DATA_API_KEY=

# Phase 2 MT5 (READ ONLY) — false par défaut, le moteur boot identique avec
# ou sans mt5-bridge. Voir ichivol-app/mt5-bridge/README.md.
MT5_ENABLED=false
MT5_MODE=READ_ONLY
MT5_BRIDGE_URL=http://mt5-bridge:8000
