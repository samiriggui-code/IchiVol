DATABASE_URL=postgresql+psycopg://postgres:root@127.0.0.1:5432/ichivol_engine_dev
ENGINE_API_PREFIX=/api/engine
LOG_LEVEL=info
# Phase 1b — multi-actifs (ne pas committer la vraie clé ; mettre dans .env)
TWELVE_DATA_API_KEY=

# --- Ève / JEV / Event Radar (Settings schema Basic/Advanced) ---
# Secrets: JEV_API_KEY / TYPESAFE_API_KEY / JEV_PROVIDER / JEV_URL / JEV_MODEL (env only)
EVE_PAPER_AUTONOMY=false
JEV_TIMEOUT_SECONDS=5
JEV_MIN_CONFIDENCE=0.45
EVE_ENTRY_GATE_MIN_CONFIDENCE=0.55
EVENT_RADAR_ENABLED=false
EVENT_RADAR_JEV_MIN_CONFIDENCE=0.65
EVENT_RADAR_NEWS_LOOKBACK_DAYS=2
EVENT_RADAR_MAX_EVENTS=8
EVENT_RADAR_CRYPTO_RSS_ENABLED=true
EVENT_RADAR_YAHOO_FINANCE_RSS_ENABLED=true
EVENT_RADAR_SEC_EDGAR_ENABLED=false
