# Copy the relevant lines into deploy/vps/.env (never commit real values).
# Demo account only until MT5 execution is explicitly approved.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Only set this if your broker requires their own MT5 terminal build
# instead of the generic MetaQuotes one (docker-entrypoint.sh default).
MT5_TERMINAL_INSTALLER_URL=
